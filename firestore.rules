rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hjelpefunksjon: Sjekk om brukeren er autentisert
    function isAuthenticated() {
      return request.auth != null;
    }

    // Hjelpefunksjon: Sjekk om brukeren eier ressursen
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Brukerprofiler og underkolleksjoner (historikk, egne maler)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /history/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Felles øvelsesbibliotek: Alle kan lese, kun backend/admin kan endre
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
