rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hjelpefunksjon: Sjekk om brukeren er autentisert
    function isAuthenticated() {
      return request.auth != null;
    }

    // Hjelpefunksjon: Sjekk om brukeren eier ressursen
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Brukerprofiler og underkolleksjoner (historikk, egne maler, egne øvelser, styrkelogg)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /history/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId);
      }

      match /custom_exercises/{exerciseId} {
        allow read, write: if isOwner(userId);
      }

      match /strength_logs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Felles øvelsesbibliotek: Alle kan lese, kun backend/admin kan endre
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if false;
    }

    // Grupperom: Sikret tilgangskontroll
    match /rooms/{roomId} {
      // Alle med romkoden kan lese rommet
      allow read: if true;

      // Kun innlogget/anonym bruker kan opprette som vert
      allow create: if isAuthenticated() 
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.roomId == roomId;

      // Verten kan oppdatere økt/status, eller deltakere kan øke participantCount
      allow update: if (isAuthenticated() && resource.data.hostUid == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount']));

      // Kun verten kan slette rommet
      allow delete: if isAuthenticated() && resource.data.hostUid == request.auth.uid;
    }

    // Anonym, aggregert telemetri / statistikk (uten personopplysninger)
    match /global_stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    // Klokkesynkronisering (NTP-forenklet): hver klient skriver/leser sitt eget
    // clock_sync/{clientId}-dokument for å måle offset mot serverklokken før
    // felles start i grupperom. Ingen personopplysninger, samme åpne mønster som rooms.
    match /clock_sync/{clientId} {
      allow read, write: if true;
    }
  }
}
