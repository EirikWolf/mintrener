rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hjelpefunksjon: Sjekk om brukeren er autentisert
    function isAuthenticated() {
      return request.auth != null;
    }

    // Hjelpefunksjon: Sjekk om brukeren eier ressursen
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Brukerprofiler og underkolleksjoner (historikk, egne maler, egne øvelser, styrkelogg)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /history/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId);
      }

      match /custom_exercises/{exerciseId} {
        allow read, write: if isOwner(userId);
      }

      match /strength_logs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Felles øvelsesbibliotek: Alle kan lese, kun backend/admin kan endre
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if false;
    }

    // Grupperom: Sikret tilgangskontroll
    match /rooms/{roomId} {
      // Alle med romkoden kan lese rommet
      allow read: if true;

      // Kun innlogget/anonym bruker kan opprette som vert
      allow create: if isAuthenticated() 
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.roomId == roomId;

      // All mutasjon krever auth (revisjon §5.3: join-oppdateringen var åpen for
      // uautentiserte og ubegrenset — participantCount kunne settes til hva som helst).
      // Verten kan oppdatere økt/status; en innlogget/anonym deltaker kan KUN øke
      // participantCount med nøyaktig 1 (join), uten å røre andre felt.
      allow update: if isAuthenticated() && (
        resource.data.hostUid == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount'])
          && request.resource.data.participantCount == resource.data.participantCount + 1
        )
      );

      // Kun verten kan slette rommet
      allow delete: if isAuthenticated() && resource.data.hostUid == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Anonym, aggregert telemetri / statistikk (uten personopplysninger).
    //
    // Herdet etter revisjon §5.1: reglene sto som «allow write: if true» —
    // hvem som helst kunne slette eller erstatte hele statistikken. Telemetri
    // skrives av uautentiserte klienter (telemetryService), så vi kan ikke
    // kreve auth; i stedet krever vi at hver skriving har FORMEN til en
    // gyldig telemetri-oppdatering: kun kjente felt (diff-allowlist), kun
    // begrensede inkrementer, og lastUpdated == request.time
    // (serverTimestamp() evalueres til request.time i reglene, så en klient
    // kan ikke sende egne klokkeslett).
    // ---------------------------------------------------------------------

    // Delta-sjekk for en teller ved update: ny verdi må være et tall og kan
    // øke med maks maxDelta (0 tillatt = feltet urørt i denne skrivingen).
    function counterDeltaOk(field, maxDelta) {
      return request.resource.data.get(field, 0) is number
        && request.resource.data.get(field, 0) - resource.data.get(field, 0) >= 0
        && request.resource.data.get(field, 0) - resource.data.get(field, 0) <= maxDelta;
    }

    // Samme sjekk ved create (ingen resource å diffe mot — teller fra null).
    function counterInitOk(field, maxDelta) {
      return request.resource.data.get(field, 0) is number
        && request.resource.data.get(field, 0) >= 0
        && request.resource.data.get(field, 0) <= maxDelta;
    }

    // types-kartet (økttype → antall): regelspråket kan ikke iterere over
    // dynamiske nøkler, så vi validerer strukturelt i stedet: maks én endret
    // nøkkel per skriving (klienten øker kun én økttype per økt), ingen
    // slettede nøkler, og begrenset størrelse. RESTRISIKO (bevisst, jf.
    // revisjonens pragmatiske linje): verdien til den ene endrede nøkkelen
    // kan ikke delta-valideres og kan settes vilkårlig av en ondsinnet
    // klient — men skaden er begrenset til én enkelt økttype-teller.
    function typesMapOk(newTypes, oldTypes) {
      return newTypes is map
        && newTypes.size() <= 50
        && newTypes.diff(oldTypes).removedKeys().size() == 0
        && newTypes.diff(oldTypes).affectedKeys().size() <= 1;
    }

    // Generell regel for samlingen: alle kan lese (vises i UI), ingen kan
    // slette, og skriving tillates KUN via de spesifikke dokument-matchene
    // under (overview/ratings/exercises/perf) — andre dokument-id-er avvises.
    match /global_stats/{statId} {
      allow read: if true;
      allow delete: if false;
    }

    match /global_stats/overview {
      allow create: if request.resource.data.keys().hasOnly(
          ['totalWorkouts', 'totalSecondsTrained', 'shareLinkOpens', 'types', 'lastUpdated'])
        && request.resource.data.lastUpdated == request.time
        && counterInitOk('totalWorkouts', 1)
        && counterInitOk('totalSecondsTrained', 14400)
        && counterInitOk('shareLinkOpens', 1)
        && typesMapOk(request.resource.data.get('types', {}), {});

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['totalWorkouts', 'totalSecondsTrained', 'shareLinkOpens', 'types', 'lastUpdated'])
        && request.resource.data.lastUpdated == request.time
        && counterDeltaOk('totalWorkouts', 1)
        // 14400 s = 4 timer — romslig øvre grense for én registrert økt
        && counterDeltaOk('totalSecondsTrained', 14400)
        && counterDeltaOk('shareLinkOpens', 1)
        && typesMapOk(request.resource.data.get('types', {}), resource.data.get('types', {}));
    }

    match /global_stats/ratings {
      allow create: if request.resource.data.keys().hasOnly(
          ['for_lett', 'passe', 'for_tungt', 'lastUpdated'])
        && request.resource.data.lastUpdated == request.time
        && counterInitOk('for_lett', 1)
        && counterInitOk('passe', 1)
        && counterInitOk('for_tungt', 1);

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['for_lett', 'passe', 'for_tungt', 'lastUpdated'])
        && request.resource.data.lastUpdated == request.time
        && counterDeltaOk('for_lett', 1)
        && counterDeltaOk('passe', 1)
        && counterDeltaOk('for_tungt', 1);
    }

    // Øvelsesaggregatene har dynamiske øvelses-id-nøkler ({count, seconds,
    // name} per øvelse) — regelspråket kan ikke iterere over dem, så streng
    // delta-validering per nøkkel er upraktisk her. Pragmatisk linje (jf.
    // revisjon §5.1): krev serverstemplet lastUpdated, forby sletting av
    // nøkler, og begrens antall berørte nøkler og total dokumentstørrelse.
    // RESTRISIKO (bevisst): verdiene i de enkelte øvelses-kartene kan settes
    // vilkårlig — men skaden er avgrenset til pynte-statistikk («topp 5
    // øvelser» i UI), ikke brukerdata, og dokumentet kan ikke lenger slettes
    // eller vokse ubegrenset. Grensene er kalibrert for klientens nøstede
    // form (én toppnivå-nøkkel per øvelse + lastUpdated): ≤41 berørte nøkler
    // per skriv = maks 40 øvelser i én økt, ≤500 nøkler totalt i dokumentet.
    // Historiske FLATE punktum-nøkler («ovelse.count» som bokstavelig nøkkel,
    // fra før klienten gikk over til nøstede maps) kan ligge igjen i prod som
    // døde nøkler — de ignoreres både av regel-validerte skrivinger og av
    // fetchGlobalStats, og migreres ikke (kun kosmetisk statistikk).
    match /global_stats/exercises {
      allow create: if request.resource.data.lastUpdated == request.time
        && request.resource.data.size() <= 41;

      allow update: if request.resource.data.lastUpdated == request.time
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && request.resource.data.diff(resource.data).affectedKeys().size() <= 41
        && request.resource.data.size() <= 500;
    }

    // Ytelsestelemetri (A5, audit § 9.4/§ 7.3): long tasks/treningsminutt og
    // faseovergangs-lydavvik, aggregert per økt fra perfMonitorService via
    // telemetryService.recordPerfTelemetry. p95 kan ikke aggregeres med rene
    // increment()-er, så klienten sender i stedet ett økt-inkrement (`sessions`),
    // en heltalls long-task-teller, en stikkprøve-teller (avgrenset til
    // MAX_AUDIO_SAMPLES=200 per økt i klienten), og ÉN av tre bøtte-inkrementer
    // for øktens p95 — samme pragmatiske linje som exercises-dokumentet: kjent
    // felt-allowlist + serverstemplet lastUpdated + begrensede deltaer per felt.
    match /global_stats/perf {
      allow create: if request.resource.data.keys().hasOnly(
          ['sessions', 'longTasks', 'audioDeviationSamples',
           'deviationUnder20Ms', 'deviation20to50Ms', 'deviationOver50Ms', 'lastUpdated'])
        && request.resource.data.lastUpdated == request.time
        && counterInitOk('sessions', 1)
        // Romslig øvre grense — en enkelt økt med vedvarende hovedtråd-jank
        // kunne i teorien produsere svært mange entries, men ikke ubegrenset
        && counterInitOk('longTasks', 5000)
        && counterInitOk('audioDeviationSamples', 200)
        && counterInitOk('deviationUnder20Ms', 1)
        && counterInitOk('deviation20to50Ms', 1)
        && counterInitOk('deviationOver50Ms', 1);

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['sessions', 'longTasks', 'audioDeviationSamples',
           'deviationUnder20Ms', 'deviation20to50Ms', 'deviationOver50Ms', 'lastUpdated'])
        && request.resource.data.lastUpdated == request.time
        && counterDeltaOk('sessions', 1)
        && counterDeltaOk('longTasks', 5000)
        && counterDeltaOk('audioDeviationSamples', 200)
        && counterDeltaOk('deviationUnder20Ms', 1)
        && counterDeltaOk('deviation20to50Ms', 1)
        && counterDeltaOk('deviationOver50Ms', 1);
    }

    // Klokkesynkronisering (NTP-forenklet): hver klient skriver/leser sitt eget
    // clock_sync/{clientId}-dokument for å måle offset mot serverklokken før felles
    // start i grupperom. Ingen personopplysninger, men dokumentene er ikke eier-bundet
    // (klient-id er en tilfeldig streng, ikke en auth-uid), så vi stoler ikke på
    // isOwner/isAuthenticated her slik som for rooms. I stedet begrenses tilgangen
    // strukturelt: kun direkte get (ingen list, så samlingen ikke kan skrapes), og
    // create/update må inneholde nøyaktig ett felt («ts») satt til serverens eget
    // klokkeslett (serverTimestamp() evalueres til request.time i reglene) — en klient
    // kan altså ikke skrive noe annet enn «hva er klokken nå», hverken til seg selv
    // eller andres dokumenter.
    match /clock_sync/{clientId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['ts'])
        && request.resource.data.ts == request.time;
      allow delete: if false;
    }
  }
}
