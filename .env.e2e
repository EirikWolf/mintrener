# Miljø for Playwright-røykflyten (B4, revisjon § 5.3).
# Brukes av `npm run build:e2e` (vite build --mode e2e). Inneholder KUN
# demo-verdier — demo-mintrener er Firebase-emulatorens offline prosjekt-id
# (samme som rules-testene), så ingenting her er hemmelig.
VITE_FIREBASE_API_KEY=demo-e2e-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mintrener.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mintrener
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
